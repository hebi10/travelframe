rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCurrentUserDocument(userId) {
      return request.resource.data.uid == userId;
    }

    function isNonNegativeCount(value) {
      return value is int && value >= 0;
    }

    function isValidBackupStoragePath(userId, storagePath) {
      return storagePath is string
        && storagePath.matches('users/' + userId + '/backups/.*');
    }

    function isValidBackupFileSize(fileSize) {
      return fileSize is int
        && fileSize > 0
        && fileSize <= 250 * 1024 * 1024;
    }

    function hasValidBackupSessionId() {
      return request.resource.data.backupSessionId is string
        && request.resource.data.backupSessionId.size() > 0;
    }

    function isValidBackupFileType(fileType) {
      return fileType in ["image/jpeg", "image/png", "image/webp", "video/mp4"];
    }

    function isValidBackupDownloadUrl(userId, value) {
      return value is string
        && value.matches('https://firebasestorage.googleapis.com/v0/b/[^/]+/o/users%2F' + userId + '%2Fbackups%2F.*');
    }

    function isOptionalValidBackupDownloadUrl(userId, fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || request.resource.data[fieldName] == null
        || isValidBackupDownloadUrl(userId, request.resource.data[fieldName]);
    }

    function isValidPhotoBackupUrls(userId) {
      return isOptionalValidBackupDownloadUrl(userId, "uri")
        && isOptionalValidBackupDownloadUrl(userId, "downloadURL")
        && isOptionalValidBackupDownloadUrl(userId, "previewUri");
    }

    function isValidVideoBackupUrls(userId) {
      return isOptionalValidBackupDownloadUrl(userId, "uri")
        && isOptionalValidBackupDownloadUrl(userId, "downloadURL");
    }

    function isValidReservedBackupContentType(mediaKind, contentType) {
      return (mediaKind == "image" && contentType.matches('image/(jpeg|jpg|png|webp)'))
        || (mediaKind == "video" && contentType == "video/mp4");
    }

    function isValidReservedBackupSize(mediaKind, fileSize) {
      return (mediaKind == "image" && fileSize < 20 * 1024 * 1024)
        || (mediaKind == "video" && fileSize < 250 * 1024 * 1024);
    }

    function isValidBackupStatus(status) {
      return status in ["none", "empty", "active", "expired", "deleted", "backed_up", "failed", "restored"];
    }

    function hasOptionalNonNegativeCount(fieldName) {
      return !request.resource.data.keys().hasAny([fieldName])
        || isNonNegativeCount(request.resource.data[fieldName]);
    }

    function userDocumentKeys() {
      return [
        "uid",
        "email",
        "displayName",
        "emailVerified",
        "providerIds",
        "lastSignInAt",
        "createdAt",
        "updatedAt"
      ];
    }

    function userDocumentMutableKeys() {
      return [
        "email",
        "displayName",
        "emailVerified",
        "providerIds",
        "lastSignInAt",
        "updatedAt"
      ];
    }

    function backupOverviewKeys() {
      return [
        "userId",
        "photoCount",
        "imageBundleCount",
        "videoCount",
        "musicCount",
        "imageBackupBytes",
        "status",
        "deleteAfter",
        "backedUpAt",
        "deletedAt",
        "updatedAt",
        "settings",
        "imageBundles",
        "videos"
      ];
    }

    function backupOverviewMutableKeys() {
      return [
        "photoCount",
        "imageBundleCount",
        "videoCount",
        "musicCount",
        "imageBackupBytes",
        "status",
        "deleteAfter",
        "backedUpAt",
        "deletedAt",
        "updatedAt",
        "settings",
        "imageBundles",
        "videos"
      ];
    }

    function photoBackupKeys() {
      return [
        "id",
        "userId",
        "localId",
        "uri",
        "localUri",
        "previewUri",
        "localPreviewUri",
        "previewStoragePath",
        "localFileStatus",
        "createdAt",
        "updatedAt",
        "width",
        "height",
        "ratioLabel",
        "kind",
        "edited",
        "addedToVideo",
        "sourcePhotoId",
        "edit",
        "storagePath",
        "downloadURL",
        "fileSize",
        "fileType",
        "backupSessionId",
        "backupStatus",
        "backupEnabledAt",
        "lastBackedUpAt",
        "sourceDeviceId",
        "backedUpAt",
        "optimizedWidth",
        "optimizedHeight",
        "optimizedSize",
        "optimizedQuality",
        "imageQuality",
        "originalSize",
        "imageBackupSize"
      ];
    }

    function photoBackupMutableKeys() {
      return [
        "localUri",
        "localPreviewUri",
        "localFileStatus",
        "backupStatus",
        "backupEnabledAt",
        "lastBackedUpAt",
        "backedUpAt",
        "updatedAt",
        "optimizedWidth",
        "optimizedHeight",
        "optimizedSize",
        "optimizedQuality",
        "imageQuality",
        "originalSize",
        "imageBackupSize"
      ];
    }

    function imageWorkBackupKeys() {
      return [
        "id",
        "kind",
        "title",
        "createdAt",
        "updatedAt",
        "coverUri",
        "ratio",
        "photoIds",
        "imageUris",
        "localImageUris",
        "imageWidths",
        "imageHeights",
        "userId",
        "localId",
        "storagePath",
        "storagePaths",
        "backupSessionIds",
        "optimizedImages",
        "imageBackupSize",
        "originalBackupSize",
        "imageQuality",
        "fileSize",
        "fileType",
        "backupStatus",
        "backupEnabledAt",
        "lastBackedUpAt",
        "sourceDeviceId",
        "backedUpAt"
      ];
    }

    function imageWorkBackupMutableKeys() {
      return [
        "title",
        "updatedAt",
        "coverUri",
        "ratio",
        "photoIds",
        "imageUris",
        "localImageUris",
        "imageWidths",
        "imageHeights",
        "optimizedImages",
        "imageBackupSize",
        "originalBackupSize",
        "imageQuality",
        "fileSize",
        "fileType",
        "backupStatus",
        "backupEnabledAt",
        "lastBackedUpAt",
        "sourceDeviceId",
        "backedUpAt"
      ];
    }

    function videoBackupKeys() {
      return [
        "id",
        "userId",
        "localId",
        "uri",
        "localUri",
        "coverUri",
        "createdAt",
        "updatedAt",
        "title",
        "ratio",
        "template",
        "transition",
        "transitionDuration",
        "duration",
        "photoIds",
        "durations",
        "musicId",
        "musicLabel",
        "storagePath",
        "downloadURL",
        "fileSize",
        "fileType",
        "backupSessionId",
        "backupStatus",
        "backupEnabledAt",
        "lastBackedUpAt",
        "sourceDeviceId",
        "backedUpAt",
        "localFileStatus"
      ];
    }

    function videoBackupMutableKeys() {
      return [
        "localUri",
        "coverUri",
        "updatedAt",
        "title",
        "ratio",
        "template",
        "transition",
        "transitionDuration",
        "duration",
        "photoIds",
        "durations",
        "musicId",
        "musicLabel",
        "backupStatus",
        "backupEnabledAt",
        "lastBackedUpAt",
        "sourceDeviceId",
        "backedUpAt",
        "localFileStatus"
      ];
    }

    function isActiveSubscription(userId, productId) {
      return exists(/databases/$(database)/documents/users/$(userId)/subscriptions/$(productId))
        && get(/databases/$(database)/documents/users/$(userId)/subscriptions/$(productId)).data.plan == "premium"
        && get(/databases/$(database)/documents/users/$(userId)/subscriptions/$(productId)).data.status == "active"
        && get(/databases/$(database)/documents/users/$(userId)/subscriptions/$(productId)).data.productId == productId;
    }

    function weeklyVideoExportLimitForUser(userId) {
      return isActiveSubscription(userId, "expert_monthly")
        ? 30
        : isActiveSubscription(userId, "creator_monthly")
          ? 15
          : 1;
    }

    function hasValidBackupOwner(userId) {
      return request.resource.data.userId == userId;
    }

    function backupUploadSession(userId, backupSessionId) {
      return get(/databases/$(database)/documents/users/$(userId)/backupUploadSessions/$(backupSessionId));
    }

    function hasReservedBackupUploadSession(userId, mediaKind, backupSessionId, storagePath) {
      return backupSessionId is string
        && backupSessionId.size() > 0
        && exists(/databases/$(database)/documents/users/$(userId)/backupUploadSessions/$(backupSessionId))
        && backupUploadSession(userId, backupSessionId).data.userId == userId
        && backupUploadSession(userId, backupSessionId).data.status in ["reserved", "completed"]
        && backupUploadSession(userId, backupSessionId).data.mediaKind == mediaKind
        && backupUploadSession(userId, backupSessionId).data.storagePath == storagePath
        && isValidReservedBackupSize(mediaKind, backupUploadSession(userId, backupSessionId).data.fileSize)
        && isValidReservedBackupContentType(mediaKind, backupUploadSession(userId, backupSessionId).data.contentType)
        && backupUploadSession(userId, backupSessionId).data.expiresAt > request.time;
    }

    function hasReservedTypedBackupUploadSession(userId, mediaKind, backupSessionId, storagePath, fileSize, contentType) {
      return hasReservedBackupUploadSession(userId, mediaKind, backupSessionId, storagePath)
        && backupUploadSession(userId, backupSessionId).data.fileSize == fileSize
        && backupUploadSession(userId, backupSessionId).data.contentType == contentType;
    }

    function isValidUserWrite(userId) {
      return request.resource.data.keys().hasOnly(userDocumentKeys())
        && request.resource.data.uid == userId;
    }

    function isValidUserUpdate(userId) {
      return isValidUserWrite(userId)
        && resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userDocumentMutableKeys());
    }

    function isValidBackupOverview(userId, backupId) {
      return backupId == "current"
        && request.resource.data.keys().hasOnly(backupOverviewKeys())
        && hasValidBackupOwner(userId)
        && isNonNegativeCount(request.resource.data.photoCount)
        && isNonNegativeCount(request.resource.data.imageBundleCount)
        && isNonNegativeCount(request.resource.data.videoCount)
        && hasOptionalNonNegativeCount("musicCount")
        && isNonNegativeCount(request.resource.data.imageBackupBytes)
        && isValidBackupStatus(request.resource.data.status);
    }

    function isValidPhotoBackup(userId, photoId) {
      return hasValidBackupOwner(userId)
        && request.resource.data.keys().hasOnly(photoBackupKeys())
        && request.resource.data.localId == photoId
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('users/' + userId + '/backups/photos/.+')
        && isValidBackupFileSize(request.resource.data.fileSize)
        && isValidBackupFileType(request.resource.data.fileType)
        && request.resource.data.fileType.matches('image/.*')
        && isValidPhotoBackupUrls(userId)
        && hasValidBackupSessionId()
        && hasReservedTypedBackupUploadSession(
          userId,
          "image",
          request.resource.data.backupSessionId,
          request.resource.data.storagePath,
          request.resource.data.fileSize,
          request.resource.data.fileType
        )
        && isValidBackupStatus(request.resource.data.backupStatus);
    }

    function isValidImageWorkBackup(userId, workId) {
      return hasValidBackupOwner(userId)
        && request.resource.data.keys().hasOnly(imageWorkBackupKeys())
        && request.resource.data.localId == workId
        && request.resource.data.storagePaths is list
        && request.resource.data.storagePaths.size() > 0
        && request.resource.data.storagePaths[0] is string
        && request.resource.data.storagePaths[0].matches('users/' + userId + '/backups/image-works/.+')
        && request.resource.data.backupSessionIds is list
        && request.resource.data.backupSessionIds.size() == request.resource.data.storagePaths.size()
        && isValidBackupFileSize(request.resource.data.fileSize)
        && isNonNegativeCount(request.resource.data.imageBackupSize)
        && hasReservedBackupUploadSession(
          userId,
          "image",
          request.resource.data.backupSessionIds[0],
          request.resource.data.storagePaths[0]
        )
        && isValidBackupStatus(request.resource.data.backupStatus);
    }

    function isValidVideoBackup(userId, videoId) {
      return hasValidBackupOwner(userId)
        && request.resource.data.keys().hasOnly(videoBackupKeys())
        && request.resource.data.localId == videoId
        && isValidBackupStoragePath(userId, request.resource.data.storagePath)
        && isValidBackupFileSize(request.resource.data.fileSize)
        && request.resource.data.fileType == "video/mp4"
        && isValidVideoBackupUrls(userId)
        && hasValidBackupSessionId()
        && hasReservedTypedBackupUploadSession(
          userId,
          "video",
          request.resource.data.backupSessionId,
          request.resource.data.storagePath,
          request.resource.data.fileSize,
          request.resource.data.fileType
        )
        && isValidBackupStatus(request.resource.data.backupStatus);
    }

    function isValidPhotoBackupMetadata(userId, photoId) {
      return isValidPhotoBackup(userId, photoId);
    }

    function isValidBackupOverviewUpdate(userId, backupId) {
      return isValidBackupOverview(userId, backupId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(backupOverviewMutableKeys());
    }

    function isValidPhotoBackupUpdate(userId, photoId) {
      return hasValidBackupOwner(userId)
        && request.resource.data.keys().hasOnly(photoBackupKeys())
        && request.resource.data.localId == photoId
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('users/' + userId + '/backups/photos/.+')
        && isValidBackupFileSize(request.resource.data.fileSize)
        && isValidBackupFileType(request.resource.data.fileType)
        && request.resource.data.fileType.matches('image/.*')
        && isValidPhotoBackupUrls(userId)
        && hasValidBackupSessionId()
        && isValidBackupStatus(request.resource.data.backupStatus)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.localId == resource.data.localId
        && request.resource.data.storagePath == resource.data.storagePath
        && request.resource.data.backupSessionId == resource.data.backupSessionId
        && request.resource.data.fileSize == resource.data.fileSize
        && request.resource.data.fileType == resource.data.fileType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(photoBackupMutableKeys());
    }

    function isValidImageWorkBackupUpdate(userId, workId) {
      return isValidImageWorkBackup(userId, workId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.localId == resource.data.localId
        && request.resource.data.storagePaths == resource.data.storagePaths
        && request.resource.data.backupSessionIds == resource.data.backupSessionIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(imageWorkBackupMutableKeys());
    }

    function isValidVideoBackupMetadata(userId, videoId) {
      return isValidVideoBackup(userId, videoId);
    }

    function isValidVideoBackupUpdate(userId, videoId) {
      return hasValidBackupOwner(userId)
        && request.resource.data.keys().hasOnly(videoBackupKeys())
        && request.resource.data.localId == videoId
        && isValidBackupStoragePath(userId, request.resource.data.storagePath)
        && isValidBackupFileSize(request.resource.data.fileSize)
        && request.resource.data.fileType == "video/mp4"
        && isValidVideoBackupUrls(userId)
        && hasValidBackupSessionId()
        && isValidBackupStatus(request.resource.data.backupStatus)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.localId == resource.data.localId
        && request.resource.data.storagePath == resource.data.storagePath
        && request.resource.data.backupSessionId == resource.data.backupSessionId
        && request.resource.data.fileSize == resource.data.fileSize
        && request.resource.data.fileType == resource.data.fileType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(videoBackupMutableKeys());
    }

    function isValidImageWorkBackupMetadata(userId, workId) {
      return isValidImageWorkBackup(userId, workId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserWrite(userId);
      allow update: if isOwner(userId) && isValidUserUpdate(userId);
      allow delete: if false;

      match /videos/{videoId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidVideoBackupMetadata(userId, videoId);
        allow update: if isOwner(userId) && isValidVideoBackupUpdate(userId, videoId);
        allow delete: if false;
      }

      match /imageWorks/{workId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if false;
        allow delete: if false;
      }

      match /musicTracks/{trackId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /musicUploadSessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /backups/{backupId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidBackupOverview(userId, backupId);
        allow update: if isOwner(userId) && isValidBackupOverviewUpdate(userId, backupId);
        allow delete: if false;
      }

      match /photoBackups/{photoId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidPhotoBackupMetadata(userId, photoId);
        allow update: if isOwner(userId) && isValidPhotoBackupUpdate(userId, photoId);
        allow delete: if false;
      }

      match /backupUsage/{usageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /backupUploadSessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /usage/{usageGroup}/weeks/{weekId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if false;
        allow delete: if isAdmin();
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /paymentEvents/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
