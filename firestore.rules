rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isCurrentUserDocument(userId) {
      return request.resource.data.uid == userId;
    }

    function isNonNegativeCount(value) {
      return value is int && value >= 0;
    }

    function isValidBackupStoragePath(userId, storagePath) {
      return storagePath is string
        && storagePath.matches('users/' + userId + '/backups/.*');
    }

    function isValidBackupFileSize(fileSize) {
      return fileSize is int
        && fileSize > 0
        && fileSize <= 250 * 1024 * 1024;
    }

    function hasValidBackupSessionId() {
      return request.resource.data.backupSessionId is string
        && request.resource.data.backupSessionId.size() > 0;
    }

    function isValidBackupFileType(fileType) {
      return fileType in ["image/jpeg", "image/png", "image/webp", "video/mp4"];
    }

    function isValidBackupStatus(status) {
      return status in ["none", "active", "expired", "deleted", "backed_up", "failed", "restored"];
    }

    function isActiveSubscription(userId, productId) {
      return exists(/databases/$(database)/documents/users/$(userId)/subscriptions/$(productId))
        && get(/databases/$(database)/documents/users/$(userId)/subscriptions/$(productId)).data.plan == "premium"
        && get(/databases/$(database)/documents/users/$(userId)/subscriptions/$(productId)).data.status == "active"
        && get(/databases/$(database)/documents/users/$(userId)/subscriptions/$(productId)).data.productId == productId;
    }

    function weeklyVideoExportLimitForUser(userId) {
      return isActiveSubscription(userId, "expert_monthly")
        ? 30
        : isActiveSubscription(userId, "creator_monthly")
          ? 15
          : 1;
    }

    function hasValidBackupOwner(userId) {
      return request.resource.data.userId == userId;
    }

    function isValidBackupOverview(userId, backupId) {
      return backupId == "current"
        && hasValidBackupOwner(userId)
        && isNonNegativeCount(request.resource.data.photoCount)
        && isNonNegativeCount(request.resource.data.imageBundleCount)
        && isNonNegativeCount(request.resource.data.videoCount)
        && isNonNegativeCount(request.resource.data.imageBackupBytes)
        && isValidBackupStatus(request.resource.data.status);
    }

    function isValidPhotoBackup(userId, photoId) {
      return hasValidBackupOwner(userId)
        && request.resource.data.localId == photoId
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('users/' + userId + '/backups/photos/.+')
        && isValidBackupFileSize(request.resource.data.fileSize)
        && isValidBackupFileType(request.resource.data.fileType)
        && request.resource.data.fileType.matches('image/.*')
        && hasValidBackupSessionId()
        && isValidBackupStatus(request.resource.data.backupStatus);
    }

    function isValidImageWorkBackup(userId, workId) {
      return hasValidBackupOwner(userId)
        && request.resource.data.localId == workId
        && request.resource.data.storagePaths is list
        && request.resource.data.storagePaths.size() > 0
        && request.resource.data.storagePaths[0] is string
        && request.resource.data.storagePaths[0].matches('users/' + userId + '/backups/image-works/.+')
        && request.resource.data.backupSessionIds is list
        && request.resource.data.backupSessionIds.size() == request.resource.data.storagePaths.size()
        && isValidBackupFileSize(request.resource.data.fileSize)
        && isNonNegativeCount(request.resource.data.imageBackupSize)
        && isValidBackupStatus(request.resource.data.backupStatus);
    }

    function isValidVideoBackup(userId, videoId) {
      return hasValidBackupOwner(userId)
        && request.resource.data.localId == videoId
        && isValidBackupStoragePath(userId, request.resource.data.storagePath)
        && isValidBackupFileSize(request.resource.data.fileSize)
        && request.resource.data.fileType == "video/mp4"
        && hasValidBackupSessionId()
        && isValidBackupStatus(request.resource.data.backupStatus);
    }

    function isValidPhotoBackupMetadata(userId, photoId) {
      return isValidPhotoBackup(userId, photoId);
    }

    function isValidVideoBackupMetadata(userId, videoId) {
      return isValidVideoBackup(userId, videoId);
    }

    function isValidImageWorkBackupMetadata(userId, workId) {
      return isValidImageWorkBackup(userId, workId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isCurrentUserDocument(userId);
      allow update: if isOwner(userId)
        && resource.data.uid == userId
        && isCurrentUserDocument(userId);
      allow delete: if false;

      match /videos/{videoId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidVideoBackupMetadata(userId, videoId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /imageWorks/{workId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidImageWorkBackupMetadata(userId, workId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /musicTracks/{trackId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if false;
      }

      match /musicUploadSessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /backups/{backupId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidBackupOverview(userId, backupId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /photoBackups/{photoId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidPhotoBackupMetadata(userId, photoId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /backupUsage/{usageId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /backupUploadSessions/{sessionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /usage/{usageGroup}/weeks/{weekId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && usageGroup == "videoExports"
          && request.resource.data.userId == userId
          && request.resource.data.weekId == weekId
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= weeklyVideoExportLimitForUser(userId)
          && request.resource.data.limit == weeklyVideoExportLimitForUser(userId);
        allow delete: if isAdmin();
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /paymentEvents/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
