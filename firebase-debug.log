[debug] [2026-05-19T08:34:10.891Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/travelframe-4e1fb/rulesets {"name":"projects/travelframe-4e1fb/rulesets/12a7aac4-8399-45be-8386-da5d263cc8e2","source":{"files":[{"content":"rules_version = '2';\n\nservice firebase.storage {\n  match /b/{bucket}/o {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return signedIn() && request.auth.uid == userId;\n    }\n\n    function isImageUpload() {\n      return request.resource.size < 20 * 1024 * 1024\n        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');\n    }\n\n    function isVideoUpload() {\n      return request.resource.size < 250 * 1024 * 1024\n        && request.resource.contentType == 'video/mp4';\n    }\n\n    function isAudioUpload() {\n      return request.resource.size < 50 * 1024 * 1024\n        && request.resource.contentType.matches('audio/.*');\n    }\n\n    function hasBackupSession() {\n      return request.resource.metadata.backupSessionId is string\n        && request.resource.metadata.backupSessionId.size() > 0;\n    }\n\n    function backupSession(userId) {\n      return firestore.get(/databases/(default)/documents/users/$(userId)/backupUploadSessions/$(request.resource.metadata.backupSessionId));\n    }\n\n    function isReservedBackupUpload(userId, mediaKind) {\n      return isOwner(userId)\n        && hasBackupSession()\n        && backupSession(userId).data.userId == userId\n        && backupSession(userId).data.status == \"reserved\"\n        && backupSession(userId).data.mediaKind == mediaKind\n        && backupSession(userId).data.storagePath == request.resource.name\n        && backupSession(userId).data.fileSize == request.resource.size\n        && backupSession(userId).data.contentType == request.resource.contentType\n        && backupSession(userId).data.expiresAt > request.time;\n    }\n\n    match /users/{userId}/backups/photos/{fileName} {\n      allow read: if isOwner(userId);\n      allow create, update: if isReservedBackupUpload(userId, \"image\") && isImageUpload();\n      allow delete: if false;\n    }\n\n    match /users/{userId}/backups/image-works/{workId}/{fileName} {\n      allow read: if isOwner(userId);\n      allow create, update: if isReservedBackupUpload(userId, \"image\") && isImageUpload();\n      allow delete: if false;\n    }\n\n    match /users/{userId}/backups/videos/{fileName} {\n      allow read: if isOwner(userId);\n      allow create, update: if isReservedBackupUpload(userId, \"video\") && isVideoUpload();\n      allow delete: if false;\n    }\n\n    match /users/{userId}/backups/audio/{fileName} {\n      allow read: if isOwner(userId);\n      allow create, update: if isReservedBackupUpload(userId, \"audio\") && isAudioUpload();\n      allow delete: if false;\n    }\n\n    match /users/{userId}/music/{allPaths=**} {\n      allow read: if isOwner(userId);\n      allow create, update: if isOwner(userId)\n        && isAudioUpload();\n      allow delete: if isOwner(userId);\n    }\n\n    match /{allPaths=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-05-19T08:34:10.959295Z","metadata":{"services":["firebase.storage"]}}
