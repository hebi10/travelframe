{
  "expo": {
    "name": "바디 프레임",
    "slug": "photo-guide",
    "scheme": [
      "bodyframe",
      "photoguide",
      "com.haebi.photoguide"
    ],
    "description": "같은 구도와 자세로 몸의 변화를 기록하고, Android에서는 사용자가 선택해 Health Connect의 몸무게·체지방률을 불러와 변화 추이를 확인할 수 있는 바디 기록 앱입니다.",
    "version": "1.0.30",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "splash": {
      "image": "./assets/icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#151719"
    },
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.haebi.photoguide",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#151719"
      },
      "splash": {
        "image": "./assets/icons/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#151719"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-iap",
      "react-native-health-connect",
      "./plugins/with-body-pose-alignment",
      "./plugins/with-android-release-manifest",
      "./plugins/with-project-reminder",
      [
        "expo-image-picker",
        {
          "photosPermission": "바디 프레임에서 기준 사진을 불러오고 몸의 변화를 기록하기 위해 사진 보관함 접근 권한이 필요합니다.",
          "cameraPermission": "바디 프레임에서 몸의 변화 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "바디 프레임에서 기준 사진과 기록 사진을 확인하기 위해 사진 보관함 접근 권한이 필요합니다.",
          "savePhotosPermission": "바디 프레임에서 기록 사진과 변화 영상을 저장하기 위해 사진 및 영상 저장 권한이 필요합니다.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-document-picker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3239289311207399~9959086380",
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "react-native-google-mobile-ads": {
      "android_app_id": "ca-app-pub-3239289311207399~9959086380"
    },
    "extra": {
      "router": {},
      "privacyPolicyUrl": "https://travelframe-4e1fb.web.app/privacy",
      "admob": {
        "androidAppId": "ca-app-pub-3239289311207399~9959086380",
        "androidBannerAdUnitId": "ca-app-pub-3239289311207399/3281997392",
        "androidInterstitialAdUnitId": "ca-app-pub-3239289311207399/5093683221"
      },
      "eas": {
        "projectId": "36ca0ec3-771c-4cd9-9700-4610ea87edb9"
      }
    }
  }
}
