rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImageUpload() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function isVideoUpload() {
      return request.resource.size < 250 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
    }

    function isAudioUpload() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    function hasBackupSession() {
      return request.resource.metadata.backupSessionId is string
        && request.resource.metadata.backupSessionId.size() > 0;
    }

    function backupSession(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)/backupUploadSessions/$(request.resource.metadata.backupSessionId));
    }

    function hasMusicSession() {
      return request.resource.metadata.musicSessionId is string
        && request.resource.metadata.musicSessionId.size() > 0;
    }

    function musicUploadSession(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)/musicUploadSessions/$(request.resource.metadata.musicSessionId));
    }

    function isReservedBackupUpload(userId, mediaKind) {
      return isOwner(userId)
        && hasBackupSession()
        && backupSession(userId).data.userId == userId
        && backupSession(userId).data.status == "reserved"
        && backupSession(userId).data.mediaKind == mediaKind
        && backupSession(userId).data.storagePath == request.resource.name
        && backupSession(userId).data.fileSize == request.resource.size
        && backupSession(userId).data.contentType == request.resource.contentType
        && backupSession(userId).data.expiresAt > request.time;
    }

    function isReservedMusicUpload(userId) {
      return isOwner(userId)
        && hasMusicSession()
        && musicUploadSession(userId).data.userId == userId
        && musicUploadSession(userId).data.status == "reserved"
        && musicUploadSession(userId).data.storagePath == request.resource.name
        && musicUploadSession(userId).data.fileSize == request.resource.size
        && musicUploadSession(userId).data.contentType == request.resource.contentType
        && musicUploadSession(userId).data.expiresAt > request.time;
    }

    match /users/{userId}/backups/photos/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isReservedBackupUpload(userId, "image") && isImageUpload();
      allow delete: if false;
    }

    match /users/{userId}/backups/image-works/{workId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isReservedBackupUpload(userId, "image") && isImageUpload();
      allow delete: if false;
    }

    match /users/{userId}/backups/videos/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isReservedBackupUpload(userId, "video") && isVideoUpload();
      allow delete: if false;
    }

    match /users/{userId}/backups/audio/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if isReservedBackupUpload(userId, "audio") && isAudioUpload();
      allow delete: if false;
    }

    match /users/{userId}/music/{allPaths=**} {
      allow read: if isOwner(userId);
      allow create, update: if isReservedMusicUpload(userId) && isAudioUpload();
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
