rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isImageUpload() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function isVideoUpload() {
      return request.resource.size < 250 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
    }

    function isAudioUpload() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    function isValidReservedContentType(mediaKind, contentType) {
      return (mediaKind == "image" && contentType.matches('image/(jpeg|jpg|png|webp)'))
        || (mediaKind == "video" && contentType == "video/mp4")
        || (mediaKind == "audio" && contentType.matches('audio/.*'));
    }

    function isValidReservedSize(mediaKind, fileSize) {
      return (mediaKind == "image" && fileSize < 20 * 1024 * 1024)
        || (mediaKind == "video" && fileSize < 250 * 1024 * 1024)
        || (mediaKind == "audio" && fileSize < 50 * 1024 * 1024);
    }

    function requestContentTypeMatchesSession(contentType) {
      return request.resource.contentType == contentType
        || request.resource.contentType == "application/octet-stream";
    }

    function hasBackupSession(backupSessionId) {
      return backupSessionId is string && backupSessionId.size() > 0;
    }

    function backupSession(userId, backupSessionId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)/backupUploadSessions/$(backupSessionId));
    }

    function hasMusicSession() {
      return request.resource.metadata.musicSessionId is string
        && request.resource.metadata.musicSessionId.size() > 0;
    }

    function hasAdminBackupSession() {
      return request.resource.metadata.adminBackupSessionId is string
        && request.resource.metadata.adminBackupSessionId.size() > 0;
    }

    function musicUploadSession(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)/musicUploadSessions/$(request.resource.metadata.musicSessionId));
    }

    function adminBackupSession(userId) {
      return firestore.get(/databases/(default)/documents/users/$(userId)/adminBackupUploadSessions/$(request.resource.metadata.adminBackupSessionId));
    }

    function isReservedBackupUpload(userId, mediaKind, backupSessionId) {
      return isOwner(userId)
        && hasBackupSession(backupSessionId)
        && backupSession(userId, backupSessionId).data.userId == userId
        && backupSession(userId, backupSessionId).data.status == "reserved"
        && backupSession(userId, backupSessionId).data.mediaKind == mediaKind
        && backupSession(userId, backupSessionId).data.storagePath == request.resource.name
        && backupSession(userId, backupSessionId).data.fileSize == request.resource.size
        && isValidReservedSize(mediaKind, backupSession(userId, backupSessionId).data.fileSize)
        && isValidReservedContentType(mediaKind, backupSession(userId, backupSessionId).data.contentType)
        && requestContentTypeMatchesSession(backupSession(userId, backupSessionId).data.contentType)
        && backupSession(userId, backupSessionId).data.expiresAt > request.time;
    }

    function isReservedMetadataBackupUpload(userId, mediaKind) {
      return request.resource.metadata.backupSessionId is string
        && isReservedBackupUpload(userId, mediaKind, request.resource.metadata.backupSessionId);
    }

    function isReservedMusicUpload(userId) {
      return isOwner(userId)
        && hasMusicSession()
        && musicUploadSession(userId).data.userId == userId
        && musicUploadSession(userId).data.status == "reserved"
        && musicUploadSession(userId).data.storagePath == request.resource.name
        && musicUploadSession(userId).data.fileSize == request.resource.size
        && requestContentTypeMatchesSession(musicUploadSession(userId).data.contentType)
        && musicUploadSession(userId).data.expiresAt > request.time;
    }

    function isReservedAdminBackupUpload(userId, mediaKind) {
      return isAdmin()
        && hasAdminBackupSession()
        && adminBackupSession(userId).data.targetUid == userId
        && adminBackupSession(userId).data.adminUid == request.auth.uid
        && adminBackupSession(userId).data.status == "reserved"
        && adminBackupSession(userId).data.mediaKind == mediaKind
        && adminBackupSession(userId).data.storagePath == request.resource.name
        && adminBackupSession(userId).data.fileSize == request.resource.size
        && adminBackupSession(userId).data.contentType == request.resource.contentType
        && adminBackupSession(userId).data.expiresAt > request.time;
    }

    function isReservedAdminMusicUpload(userId) {
      return isReservedAdminBackupUpload(userId, "audio");
    }

    match /users/{userId}/backups/photos/{backupSessionId}/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isReservedBackupUpload(userId, "image", backupSessionId) || (isReservedAdminBackupUpload(userId, "image") && isImageUpload());
      allow write: if resource == null && (isReservedBackupUpload(userId, "image", backupSessionId) || (isReservedAdminBackupUpload(userId, "image") && isImageUpload()));
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/backups/photos/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isReservedMetadataBackupUpload(userId, "image") || (isReservedAdminBackupUpload(userId, "image") && isImageUpload());
      allow write: if resource == null && (isReservedMetadataBackupUpload(userId, "image") || (isReservedAdminBackupUpload(userId, "image") && isImageUpload()));
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/backups/image-works/{workId}/{backupSessionId}/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isReservedBackupUpload(userId, "image", backupSessionId) || (isReservedAdminBackupUpload(userId, "image") && isImageUpload());
      allow write: if resource == null && (isReservedBackupUpload(userId, "image", backupSessionId) || (isReservedAdminBackupUpload(userId, "image") && isImageUpload()));
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/backups/image-works/{workId}/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isReservedMetadataBackupUpload(userId, "image") || (isReservedAdminBackupUpload(userId, "image") && isImageUpload());
      allow write: if resource == null && (isReservedMetadataBackupUpload(userId, "image") || (isReservedAdminBackupUpload(userId, "image") && isImageUpload()));
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/backups/videos/{backupSessionId}/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isReservedBackupUpload(userId, "video", backupSessionId) || (isReservedAdminBackupUpload(userId, "video") && isVideoUpload());
      allow write: if resource == null && (isReservedBackupUpload(userId, "video", backupSessionId) || (isReservedAdminBackupUpload(userId, "video") && isVideoUpload()));
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/backups/videos/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isReservedMetadataBackupUpload(userId, "video") || (isReservedAdminBackupUpload(userId, "video") && isVideoUpload());
      allow write: if resource == null && (isReservedMetadataBackupUpload(userId, "video") || (isReservedAdminBackupUpload(userId, "video") && isVideoUpload()));
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/backups/audio/{backupSessionId}/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isReservedBackupUpload(userId, "audio", backupSessionId) || (isReservedAdminBackupUpload(userId, "audio") && isAudioUpload());
      allow write: if resource == null && (isReservedBackupUpload(userId, "audio", backupSessionId) || (isReservedAdminBackupUpload(userId, "audio") && isAudioUpload()));
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/backups/audio/{fileName} {
      allow read: if isOwner(userId);
      allow create: if isReservedMetadataBackupUpload(userId, "audio") || (isReservedAdminBackupUpload(userId, "audio") && isAudioUpload());
      allow write: if resource == null && (isReservedMetadataBackupUpload(userId, "audio") || (isReservedAdminBackupUpload(userId, "audio") && isAudioUpload()));
      allow update: if false;
      allow delete: if false;
    }

    match /users/{userId}/music/{allPaths=**} {
      allow read: if isOwner(userId);
      allow create: if resource == null && (isReservedMusicUpload(userId) || isReservedAdminMusicUpload(userId));
      allow update: if false;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
