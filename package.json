{
  "name": "travel-frame",
  "version": "1.0.30",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/apply-patches.mjs",
    "start": "expo start",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-android.ps1",
    "android:dev": "expo start --dev-client --android",
    "android:dev:clear": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-android-dev-clear.ps1",
    "android:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"adb uninstall com.haebi.photoguide; exit 0\"",
    "android:run-latest": "eas build:run --platform android --latest",
    "android:reset-install": "npm run android:uninstall && npm run android:run-latest",
    "android:build-dev": "eas build --profile development --platform android",
    "android:build-prod": "eas build --platform android --profile production",
    "android:build-prod-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-aab.ps1",
    "android:verify:kotlin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-debug.ps1 -Mode Kotlin -TimeoutSeconds 180 -KillStaleProcesses",
    "android:verify:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-debug.ps1 -Mode Assemble -TimeoutSeconds 420 -NativeArchitectures x86_64 -KillStaleProcesses",
    "android:verify:debug:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-debug.ps1 -Mode Assemble -TimeoutSeconds 1200 -KillStaleProcesses",
    "android:manifest:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-debug.ps1 -Mode ManifestDebug -TimeoutSeconds 180 -KillStaleProcesses",
    "android:manifest:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-debug.ps1 -Mode ManifestRelease -TimeoutSeconds 240 -KillStaleProcesses",
    "lint": "expo lint",
    "format:check": "npm run lint",
    "test": "node scripts/run-tests.mjs",
    "test:firebase-rules": "node scripts/run-firebase-rules-tests.mjs",
    "quality": "npm run typecheck && npm run format:check && npm test && npm run security:secrets",
    "quality:functions": "npm --prefix functions run quality",
    "quality:firebase-rules": "npm run test:firebase-rules",
    "security:secrets": "node scripts/run-gitleaks.mjs",
    "security:secrets:history": "node scripts/run-gitleaks.mjs --history",
    "typecheck": "tsc --noEmit",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules,storage --project travelframe-4e1fb",
    "firebase:deploy-functions": "firebase deploy --only functions --project travelframe-4e1fb",
    "firebase:deploy-hosting": "firebase deploy --only hosting --project travelframe-4e1fb",
    "firebase:deploy-all": "firebase deploy --only hosting,firestore:rules,storage,functions --project travelframe-4e1fb",
    "deploy:firebase": "firebase deploy --only hosting,firestore:rules,storage,functions --project travelframe-4e1fb"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^55.0.0",
    "expo-audio": "^55.0.0",
    "expo-auth-session": "~55.0.16",
    "expo-constants": "^55.0.0",
    "expo-dev-client": "~55.0.33",
    "expo-document-picker": "^55.0.0",
    "expo-file-system": "^55.0.0",
    "expo-font": "~55.0.7",
    "expo-haptics": "^55.0.0",
    "expo-image": "^55.0.0",
    "expo-image-manipulator": "^55.0.0",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "^55.0.0",
    "expo-media-library": "^55.0.0",
    "expo-router": "^55.0.0",
    "expo-sharing": "^55.0.0",
    "expo-status-bar": "^55.0.0",
    "expo-video": "^55.0.0",
    "firebase": "^12.13.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-nitro-image": "^0.14.0",
    "react-native-nitro-modules": "^0.35.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-view-recorder": "^0.4.1",
    "react-native-vision-camera": "^5.0.9",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "^55.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@react-native/virtualized-lists": "0.83.6",
    "js-yaml": "^4.2.0",
    "react-native": "0.83.6",
    "uuid": "^11.1.1"
  }
}
